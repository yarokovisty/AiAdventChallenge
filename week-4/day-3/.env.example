# Ключ Z.ai (вкладка API Keys в дашборде Z.ai).
# Нужен агенту: LLM GLM вызывается через OpenAI-совместимый coding-эндпоинт.
# Сам MCP-сервер журнала погоды ключей не требует (Open-Meteo бесплатный).
ZAI_API_KEY=your_api_key_here

# Необязательно: переопределить модель и эндпоинт Z.ai.
# ZAI_MODEL=glm-4.6
# ZAI_ENDPOINT=https://api.z.ai/api/coding/paas/v4/chat/completions

# Параметры сервера журнала (передаются подпроцессу сервера):
# интервал планировщика в секундах (по умолчанию 600 = 10 минут)
# JOURNAL_INTERVAL_SEC=600
