# Ключ Z.ai (вкладка API Keys в дашборде Z.ai).
# Нужен агенту (LLM-оркестратор) И серверу конвейера: на стадии «обработка»
# LLM GLM генерирует текстовый вывод по агрегатам погоды.
# Нет ключа или сбой LLM → сервер переключается на вывод по правилам.
ZAI_API_KEY=your_api_key_here

# Необязательно: переопределить модель и эндпоинт Z.ai.
# ZAI_MODEL=glm-4.6
# ZAI_ENDPOINT=https://api.z.ai/api/coding/paas/v4/chat/completions

# Параметры сервера конвейера (передаются подпроцессу):
# путь к файлу SQLite (по умолчанию pipeline.db рядом со скриптом сервера)
# PIPELINE_DB=pipeline.db
