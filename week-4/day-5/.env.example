# Ключ Z.ai (вкладка API Keys в дашборде Z.ai).
# Нужен агенту (LLM-оркестратор) И pipeline-серверу: на стадии «обработка»
# LLM GLM генерирует текстовый вывод по агрегатам погоды.
# Нет ключа или сбой LLM → сервер переключается на вывод по правилам.
ZAI_API_KEY=your_api_key_here

# Необязательно: переопределить модель и эндпоинт Z.ai.
# ZAI_MODEL=glm-4.6
# ZAI_ENDPOINT=https://api.z.ai/api/coding/paas/v4/chat/completions

# Параметры серверов (передаются подпроцессам приложением):
# journal: интервал фонового планировщика, сек (day-5 ставит 3600 —
#          в мульти-серверном демо замер делается через collect_now)
# JOURNAL_INTERVAL_SEC=3600
# journal: путь к SQLite журнала (по умолчанию weather_journal.db рядом со скриптом)
# JOURNAL_DB=weather_journal.db
# pipeline: путь к SQLite конвейера (по умолчанию pipeline.db рядом со скриптом)
# PIPELINE_DB=pipeline.db
