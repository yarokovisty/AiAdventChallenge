# Ключ Z.ai (вкладка API Keys в дашборде Z.ai).
# Нужен для подключения к remote MCP-серверу Z.ai (web_search_prime).
# Сам сервер доступен подписчикам GLM Coding Plan — без плана будет отказ на авторизации.
ZAI_API_KEY=your_api_key_here

# Необязательно: переопределить endpoint remote MCP Z.ai.
# По умолчанию используется https://api.z.ai/api/mcp/web_search_prime/mcp
# ZAI_MCP_URL=https://api.z.ai/api/mcp/web_search_prime/mcp
