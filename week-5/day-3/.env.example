# Ключ Z.ai (страница API Keys в консоли Z.ai). Скопируйте этот файл в .env и впишите ключ.
# .env в .gitignore — ключ в git не попадает.
ZAI_API_KEY=your_api_key_here

# Переопределяемые параметры (значения по умолчанию — в rag_rerank.py):
# ZAI_CHAT_URL=https://api.z.ai/api/coding/paas/v4/chat/completions
# ZAI_MODEL=glm-4.6
