# Ключ Z.ai (вкладка API Keys в дашборде Z.ai). Скопировать в .env и вписать свой.
# Используется для попытки embeddings API; при недоступности скрипт сам
# переходит на локальную модель sentence-transformers.
ZAI_API_KEY=your_api_key_here

# Необязательные переопределения:
# ZAI_EMBED_URL=https://api.z.ai/api/paas/v4/embeddings
# ZAI_EMBED_MODEL=embedding-3
# LOCAL_EMBED_MODEL=intfloat/multilingual-e5-small
