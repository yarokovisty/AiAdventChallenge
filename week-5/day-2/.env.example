# Ключ Z.ai (вкладка API Keys в дашборде Z.ai). Скопировать в .env и вписать свой.
# Используется для генерации ответов (chat/completions, glm-4.6).
ZAI_API_KEY=your_api_key_here

# Необязательные переопределения:
# ZAI_CHAT_URL=https://api.z.ai/api/coding/paas/v4/chat/completions
# ZAI_MODEL=glm-4.6
