# Ключ Z.ai (инструкция по получению — см. страницу API Keys на Z.ai).
# Скопируйте этот файл в .env и впишите свой ключ.
# .env в .gitignore — ключ в git не попадает.
ZAI_API_KEY=your_api_key_here

# Необязательные переопределения (значения по умолчанию — в rag_chat.py):
# ZAI_CHAT_URL=https://api.z.ai/api/coding/paas/v4/chat/completions
# ZAI_MODEL=glm-4.6
